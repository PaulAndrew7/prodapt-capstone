# Copy to .env for local overrides. Every value here is read by the API only; nothing is
# exposed to the web client (the web app has no secrets; VITE_* values are public).

# development | test | production. Production refuses development defaults.
APP_ENV=development

# Postgres + pgvector. `python -m app.cli db-start` runs a local server with this user,
# password, port and database (installed with the Python dependencies; no Docker needed).
DATABASE_URL=postgresql+psycopg://clause:clause@localhost:5433/clause
# Data directory of that local server. Relative to the API process.
# LOCAL_DB_DIR=var/postgres

# Session signing secret, at least 32 characters in production.
SESSION_SECRET=dev-only-session-secret-change-me

# demo: every request acts as the seeded demo admin (local only, rejected in production).
# session: real sign-in (F15).
AUTH_MODE=demo

# JSON list of browser origins allowed by CORS (same-origin proxy needs none).
CORS_ORIGINS=["http://localhost:5173"]

# Original policy files and the local embedding model cache. Relative to the API process.
# STORAGE_DIR=var/storage
# MODEL_CACHE_DIR=var/models
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200

# Local dense embeddings (downloads ~70 MB on first use). false = lexical search only.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Runtime language model for lookup answers and the analysis/validation/recommendation
# stages. none | openai_compatible | anthropic. No model is needed for local review.
# Check with: python -m app.cli check-model
#
# The project runs on Claude through the Anthropic API (the latest evaluation used Sonnet 5.5):
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5-5   # or claude-haiku-4-5, cheaper for test runs
#   LLM_EFFORT=low                # thinking effort; remove for claude-haiku-4-5, which rejects it
#   LLM_API_KEY=sk-ant-...        # server-side only, never in a VITE_* variable
#
# Or the organizers' gateway (GPT-4o mini). It picks the model itself, so leave LLM_MODEL
# unset and no model name is sent:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://keygateway1.arshnivlabs.com/v1
#   LLM_API_KEY=<your lab key>   # server-side only, never in a VITE_* variable
#   LLM_JSON_MODE=json           # it accepts response_format "json" as a plain string only
#   LLM_MAX_OUTPUT_TOKENS=500    # it rejects more; longer replies are continued
#   LLM_TEMPERATURE=0            # its default is 1.0; 0 keeps verdicts steadier
LLM_PROVIDER=none
# auto: use a model when configured, continue locally after model failures (default).
# offline: no model client or calls, even with credentials. required: model-only, fail on errors.
LLM_MODE=auto
# Maximum seconds for one model stage request, including continuations; also run-deadline bounded.
LLM_CALL_TIMEOUT_SECONDS=20
# LLM_BASE_URL=            # the gateway base URL (ends before /chat/completions)
# LLM_MODEL=               # only for gateways that need a model name
# LLM_API_KEY=
# Optional: header that carries the key, e.g. api-key (unset = Authorization: Bearer <key>).
# LLM_API_KEY_HEADER=
# json_schema (default) | json_object, for gateways without JSON-schema support | json.
# LLM_JSON_MODE=json_schema
# Optional sampling temperature for the gateway, e.g. 0 (unset = model default).
# LLM_TEMPERATURE=
# Reply cap per request (default 4096); a reply cut off at the cap is continued.
# LLM_MAX_OUTPUT_TOKENS=4096

RUN_MAX_MODEL_CALLS=8
RUN_DEADLINE_SECONDS=120
