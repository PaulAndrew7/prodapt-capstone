# Copy to .env for local overrides. Every value here is read by the API only; nothing is
# exposed to the web client (the web app has no secrets; VITE_* values are public).

# development | test | production. Production refuses development defaults.
APP_ENV=development

# Postgres + pgvector. compose.yaml publishes the database on host port 5433.
DATABASE_URL=postgresql+psycopg://clause:clause@localhost:5433/clause

# Session signing secret, at least 32 characters in production.
SESSION_SECRET=dev-only-session-secret-change-me

# demo: every request acts as the seeded demo admin (local only, rejected in production).
# session: real sign-in (F15).
AUTH_MODE=demo

# JSON list of browser origins allowed by CORS (same-origin proxy needs none).
CORS_ORIGINS=["http://localhost:5173"]

# Original policy files and the local embedding model cache. Relative to the API process.
# STORAGE_DIR=var/storage
# MODEL_CACHE_DIR=var/models
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200

# Local dense embeddings (downloads ~70 MB on first use). false = lexical search only.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Runtime language model for the analysis/validation/recommendation agents (F06-F11).
# none | anthropic | openai. When set, LLM_MODEL and LLM_API_KEY are required.
LLM_PROVIDER=none
# LLM_MODEL=
# LLM_API_KEY=
RUN_MAX_MODEL_CALLS=8
RUN_DEADLINE_SECONDS=120
